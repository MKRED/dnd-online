# Скопировать в .env (он в .gitignore). Адрес ComfyUI на компьютере с видеокартой:
# IP в сети Radmin VPN и порт (ComfyUI запущен с --listen).
COMFY_URL=http://26.0.0.1:8188
# Куда сохранять картинки; по умолчанию apps/comfy-mcp/output/.
# COMFY_OUTPUT_DIR=
# Сколько ждать одну генерацию, в секундах; первая загрузка модели бывает долгой.
# COMFY_TIMEOUT_SEC=300
