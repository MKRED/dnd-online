DATABASE_URL=postgresql://user:password@localhost:5432/dnd_online
# Интеграционные тесты (pnpm test:e2e): отдельная база, имя обязано оканчиваться на _test —
# тесты очищают её таблицы (docs/plan/done/testing.md).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/dnd_online_test

# Секреты для подписи JWT — сгенерировать случайные строки, не использовать значения из примера.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# В секундах, необязательные — по умолчанию 15 минут / 30 дней.
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=2592000

# Origin фронтенда — нужен для CORS с credentials: true.
FRONTEND_URL=http://localhost:5173

# Лимиты карт — необязательные, ниже значения по умолчанию.
# MAP_MAX_OP_VOLUME=32768
# MAP_MAX_BATCH_VOLUME=65536
# MAP_MAX_OPS_PER_BATCH=100
# MAP_MAX_SIZE=256
# MAP_MAX_HEIGHT=64
# MAP_MAX_CHUNKS=4096
# MAP_MAX_OBJECTS=500

# Вход через лольку (OAuth 2.0). Без LOLKA_CLIENT_ID выключен: кнопки нет, маршруты 404.
# Адрес возврата в заявке один — прод, поэтому локально вход через лольку не проверить.
# LOLKA_CLIENT_ID=la_...
# LOLKA_CLIENT_SECRET=...
# LOLKA_REDIRECT_URI=https://dnd.aoshi.ru/api/auth/lolka/callback
# LOLKA_BASE_URL=https://lolka.aoshi.ru
